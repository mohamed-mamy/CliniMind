# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/clinimind

# JWT Secrets (use high-entropy random strings in production)
JWT_SECRET=your-32-character-plus-access-token-secret
JWT_REFRESH_SECRET=your-32-character-plus-refresh-token-secret

# Redis Configuration (Optional - for caching in production/V2)
REDIS_URL=redis://localhost:6379

# Cloudinary Integration (Required for document uploads and backups)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# SMTP Email Configuration (Nodemailer support for appointment and payment reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@clinimind.com
SMTP_PASS=your-smtp-password

# Allowed Origins for Socket.IO CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
